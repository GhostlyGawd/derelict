# Credentials for the asset pipeline's provider backend.
# Copy to .env, fill in what you have, then:
#   set -a && source .env && set +a
#   npm run pipeline -- --backend=provider --force
#
# Nothing here is needed to run or build the game — the assets are committed.

# ---- text→image: pick one -------------------------------------------------
FAL_KEY=
# FAL_MODEL=fal-ai/flux/dev

# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=black-forest-labs/flux-dev

# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Force a provider instead of auto-detecting from the keys above.
# IMAGE_PROVIDER=fal

# ---- image→3D -------------------------------------------------------------
MESHY_API_KEY=
# MESHY_MODEL=meshy-4

# ---- text→sound effect ----------------------------------------------------
ELEVENLABS_API_KEY=
# Raw PCM lets the pipeline normalise loudness and build seamless loops.
# SFX_OUTPUT_FORMAT=pcm_44100
# SFX_MAX_SECONDS=22
