{
  "name": "derelict",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A 3-5 minute first-person vignette in the browser. Every asset is AI-generated by a build-time pipeline.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pipeline": "node pipeline/run.js all",
    "pipeline:textures": "node pipeline/run.js textures",
    "pipeline:models": "node pipeline/run.js models",
    "pipeline:audio": "node pipeline/run.js audio",
    "pipeline:manifest": "node pipeline/run.js manifest",
    "test": "npm run test:chain && npm run test:deadend && npm run test:smoke && npm run test:walkthrough && npm run test:mobile",
    "test:chain": "node tools/chain.mjs",
    "test:deadend": "node tools/deadend.mjs",
    "test:smoke": "node tools/smoke.mjs",
    "test:walkthrough": "node tools/walkthrough.mjs",
    "test:mobile": "node tools/mobile.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "meshoptimizer": "^0.22.0",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "sharp": "^0.35.0"
  }
}
